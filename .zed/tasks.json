[
  {
    "label": "Compile C (single file)",
    "shell": {
      "program": "/bin/sh"
    },
    "cwd": "${ZED_WORKTREE_ROOT}",
    "command": "mkdir -p bin && gcc -g \"${ZED_FILE}\" -o bin/\"${ZED_STEM}\"",
    "reveal": "always",
    "reveal_target": "dock"
  },
  {
    "label": "Compile C (multiple files)",
    "shell": {
      "program": "/bin/sh"
    },
    "cwd": "${ZED_WORKTREE_ROOT}",
    "command": "mkdir -p bin && gcc -g *.c -o bin/main",
    "reveal": "always",
    "reveal_target": "dock"
  },
  {
    "label": "Compile and Run C (single file)",
    "shell": {
      "program": "/bin/sh"
    },
    "cwd": "${ZED_WORKTREE_ROOT}",
    "command": "mkdir -p bin && gcc -g \"${ZED_FILE}\" -o bin/\"${ZED_STEM}\" && ./bin/\"${ZED_STEM}\"",
    "reveal": "always",
    "reveal_target": "dock"
  },
  {
    "label": "Compile and Run C (multi file)",
    "shell": {
      "program": "/bin/sh"
    },
    "cwd": "${ZED_WORKTREE_ROOT}",
    "command": "mkdir -p bin && gcc -g *.c -o bin/main && ./bin/main",
    "reveal": "always",
    "reveal_target": "dock"
  }
]
